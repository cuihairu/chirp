# Local compile scratch space (TMPDIR bypass for /tmp quota)
.tmpbuild/

# Local-only artifacts on this box (never commit):
# `build` is a symlink into a build dir — the `build*/` pattern above matches
# directories only, so a symlink slips through it.
/build
docs/package-lock.json
overlay-ports/
.build/

# app-side protocol package build outputs
apps/shared/protocol/coverage/
apps/shared/protocol/tsconfig.tsbuildinfo

# iOS app: the Xcode project is xcodegen-generated from apps/ios/project.yml
# (the spec is the source of truth; never commit the generated project).
apps/ios/*.xcodeproj
apps/ios/xcuserdata/

# crashpad 本地落盘目录(数据库布局,不手工管理)
crash_dumps/
