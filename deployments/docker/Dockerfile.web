# chirp web 伴侣镜像:根 npm workspaces 构建 vite 产物 → nginx 托管并
# 同源反代 /ws/* 到各后端(浏览器侧默认 wss://<host>/ws/<plane>)。
# nginx 以非 root 用户跑(listen 8080,>1024 无需特权)。
FROM node:26-alpine AS build

WORKDIR /repo
# 先只拷 workspace 清单让 pnpm install 吃层缓存(pnpm workspace 缺一不可,
# 锁文件在仓库根)。pnpm 12 与根锁文件版本一致(web.yml 同款)。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/shared/protocol/package.json apps/shared/protocol/
COPY apps/web_companion/package.json apps/web_companion/
COPY sdks/ts/package.json sdks/ts/
# Node 26 镜像不再自带 corepack:先试 corepack,失败只退回 npm 装 pnpm 本体。
RUN (corepack enable && corepack prepare pnpm@12 --activate) || npm i -g pnpm@12
RUN pnpm install --frozen-lockfile

COPY proto/ts proto/ts
COPY apps/shared/protocol apps/shared/protocol
COPY apps/web_companion apps/web_companion
RUN pnpm --filter ./apps/web_companion run build

# unprivileged 变体:默认监听 8080,全部运行时目录已归 nginx 用户,
# 无需 root(master 也以 nginx 跑)。
FROM nginxinc/nginx-unprivileged:1.31-alpine

COPY deployments/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web_companion/dist /usr/share/nginx/html

EXPOSE 8080
