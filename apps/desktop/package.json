{
  "name": "chirp-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chirp 桌面聊天 App（App 平面桌面客户端）：Tauri v2 壳 + React/MUI，经 app_gateway WS 与自家 gateway+auth+chat 主线通信。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@chirp/app-protocol": "file:../shared/protocol",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.3.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@vitest/mocker@<4.1.12": "4.1.12"
    }
  }
}
