<?xml version="1.0" encoding="utf-8"?>
<!-- Chat window (design 02): back + peer avatar + title top bar, message
     list, input row with accent send circle. Presence/member subtitle and
     per-message interactions land with their feature commits. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chat_back_cd"
            android:src="@drawable/ic_back"
            app:tint="@color/chirp_text_primary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <chirp.mobile.AvatarView
            android:id="@+id/chat_avatar"
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chirp_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messages_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:paddingTop="4dp"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/hint_message"
            android:importantForAutofill="no"
            android:maxLines="4"
            android:minHeight="@dimen/send_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:textColor="@color/chirp_text_primary"
            android:textColorHint="@color/chirp_text_tertiary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/send_btn"
            android:layout_width="@dimen/send_button"
            android:layout_height="@dimen/send_button"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_send"
            android:contentDescription="@string/chat_send_cd"
            android:src="@drawable/ic_send"
            app:tint="@android:color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

</LinearLayout>
