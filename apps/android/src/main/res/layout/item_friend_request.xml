<?xml version="1.0" encoding="utf-8"?>
<!-- Pending friend request row (design 03): accept / decline actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/chirp_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="14dp"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <chirp.mobile.AvatarView
        android:id="@+id/request_avatar"
        android:layout_width="@dimen/avatar_md"
        android:layout_height="@dimen/avatar_md" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/request_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/chirp_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/request_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/friends_request_note"
            android:textColor="@color/chirp_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/request_accept"
        style="@style/Widget.Chirp.Button"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/friends_accept" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/request_decline"
        style="@style/Widget.Chirp.Button.Ghost"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/friends_decline" />
</LinearLayout>
