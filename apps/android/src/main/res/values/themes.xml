<?xml version="1.0" encoding="utf-8"?>
<!-- App theme: Material 3 dark carrying the approved prototype tokens.
     NoActionBar: every screen draws its own top bar (56dp, per spec) so the
     back/subtitle/service-state slot stays in our control. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Chirp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/chirp_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/chirp_accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/chirp_accent_soft</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/chirp_bg</item>
        <item name="colorSurface">@color/chirp_surface</item>
        <item name="colorSurfaceVariant">@color/chirp_surface2</item>
        <item name="colorSurfaceContainer">@color/chirp_surface2</item>
        <item name="colorSurfaceContainerHigh">@color/chirp_surface3</item>
        <item name="colorOutline">@color/chirp_border</item>
        <item name="colorOutlineVariant">@color/chirp_border_soft</item>

        <!-- Text: pin the three tiers so widgets do not invent their own. -->
        <item name="android:textColorPrimary">@color/chirp_text_primary</item>
        <item name="android:textColorSecondary">@color/chirp_text_secondary</item>
        <item name="android:textColorTertiary">@color/chirp_text_tertiary</item>
        <item name="colorOnSurface">@color/chirp_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/chirp_text_secondary</item>

        <!-- Status -->
        <item name="colorError">@color/chirp_danger</item>

        <!-- Chrome blends with the page background (prototype topbar/tabbar
             are near-opaque bg, not lifted surfaces). -->
        <item name="android:statusBarColor">@color/chirp_bg</item>
        <item name="android:navigationBarColor">@color/chirp_bg</item>
        <item name="android:windowBackground">@color/chirp_bg</item>
    </style>

    <!-- Pill button (prototype button language: 999px capsule, 14sp/600). -->
    <style name="Widget.Chirp.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">14sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chirp.Pill</item>
    </style>

    <style name="ShapeAppearance.Chirp.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">999dp</item>
    </style>

    <style name="Widget.Chirp.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chirp.Pill</item>
        <item name="strokeColor">@color/chirp_border</item>
        <item name="android:textColor">@color/chirp_text_secondary</item>
    </style>

    <style name="Widget.Chirp.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Chirp.Pill</item>
        <item name="strokeColor">@color/chirp_border</item>
        <item name="android:textColor">@color/chirp_danger</item>
    </style>

    <!-- Filled text field on surface-2 with the design border. -->
    <style name="Widget.Chirp.TextField" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/chirp_surface2</item>
        <item name="boxStrokeColor">@color/chirp_border</item>
        <item name="hintTextColor">@color/chirp_text_secondary</item>
        <item name="android:textColorHint">@color/chirp_text_tertiary</item>
    </style>

    <!-- Bottom nav: no pill indicator background (prototype tabs are bare). -->
    <style name="Widget.Chirp.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

</resources>
